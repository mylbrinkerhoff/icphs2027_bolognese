@article{loakesInvestigationAelMerger2014,
  title = {An {{Investigation}} of the /El/–/Æl/ {{Merger}} in {{Australian English}}: {{A Pilot Study}} on {{Production}} and {{Perception}} in {{South-West Victoria}}},
