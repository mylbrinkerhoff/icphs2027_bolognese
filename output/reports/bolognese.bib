@online{berryEstimandEstimatorComparing2026,
  title = {Estimand or Estimator? {{Comparing}} Vowel Overlap Measures against a Known Ground Truth},
  shorttitle = {Estimand or Estimator?},
  author = {Berry, Grant M},
  date = {2026-08-03},
  number = {v735g\_v3},
  url = {https://osf.io/preprints/psyarxiv/v735g_v3/},
  urldate = {2026-08-25},
  abstract = {Many scalar indices quantify acoustic category separation—the Pillai trace, Bhattacharyya distance, and the overlap coefficient—yet seldom are they computed on the same data. Disagreements are read as differences of functional but are often differences of estimator. Phontrast, a reproducible, open-source R toolkit, computes measures from one token-level table over a shared kernel density estimation backbone; a positive-control simulation with known Bayes-optimal truth separates each measure's estimand from its estimator. Location-only and Gaussian-family measures are provably unresponsive to higher-moment separation—possibility, not prevalence. Two results are empirical: (1) every estimator inflates with dimensionality at fixed sample size, whereas at two dimensions the kernel estimators understate population values by 29\% at 500 tokens per category; and (2) halving or doubling the bandwidth moves a kernel estimate by up to 0.98 of its [0, 1] scale. Two public vowel datasets demonstrate the toolkit rather than deliver phonological findings: in thirteen dimensions (MFCCs), the Bhattacharyya functional tracks overlap at r = −.951, ρ = −.989 under a matched kernel but −.710, −.849 in closed form. Crucially, the gap is the estimator, not the functional. No single functional dominates; Jensen–Shannon distance is foregrounded as a distribution-free metric that delivers an interpretable quantity.},
  pubstate = {prepublished},
  file = {/Users/mlbrinke/Zotero/storage/9F6HWKLM/Berry - 2026 - Estimand or estimator Comparing vowel overlap measures against a known ground truth.pdf}
}

